<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Cron Auto Process Queue Antrean User ZKTeco (Setiap 10 Menit) -->
        <record id="ir_cron_zk_auto_process_queue" model="ir.cron">
            <field name="name">SIRITA: Auto Match &amp; Link Antrean User ZKTeco</field>
            <field name="model_id" ref="model_zkteco_user_queue"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_process_queue()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. Cron Bersihkan Command ADMS Usang (Setiap 1 Hari) -->
        <record id="ir_cron_zk_clean_old_commands" model="ir.cron">
            <field name="name">SIRITA: Pembersihan Riwayat Command ADMS Usang</field>
            <field name="model_id" ref="model_zkteco_command"/>
            <field name="state">code</field>
            <field name="code">model.cron_clean_old_commands(days=7)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">10</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 3. Cron Monthly Auto Generate Draft Tukin (Setiap 1 Bulan) -->
        <record id="ir_cron_tukin_auto_generate" model="ir.cron">
            <field name="name">SIRITA: Auto Generate Draf Rekapitulasi Tukin Bulanan</field>
            <field name="model_id" ref="model_tukin_calculation"/>
            <field name="state">code</field>
            <field name="code">model.cron_monthly_auto_generate_tukin()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="priority">6</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. DEFINISIKAN FORMAT KERTAS DULU (LANDSCAPE) -->
    <record id="paperformat_tukin_landscape" model="report.paperformat">
        <field name="name">Tukin Landscape A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- 2. DEFINISIKAN AKSI CETAK (REPORT ACTION) -->
    <record id="action_report_tukin_matrix" model="ir.actions.report">
        <field name="name">Rekap Daftar Hadir (Matrix)</field>
        <field name="model">tukin.calculation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sirita_zkteco.report_tukin_matrix_template</field>
        <field name="print_report_name">'Rekap_Hadir_%s_%s' % (object.month, object.year)</field>
        <field name="binding_model_id" ref="sirita_zkteco.model_tukin_calculation"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="sirita_zkteco.paperformat_tukin_landscape"/>
    </record>

    <!-- 3. TEMPLAT VISUAL (QWEB) -->
    <template id="report_tukin_matrix_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <style>
                    .table-matrix { width: 100%; border-collapse: collapse; font-size: 8px; }
                    .table-matrix th, .table-matrix td { border: 1px solid black; text-align: center; padding: 2px; height: 30px; }
                    .header-top { text-align: center; margin-bottom: 20px; border-bottom: 2px solid black; padding-bottom: 5px; }
                    .header-top h3 { margin: 0; padding: 0; font-weight: bold; }
                    .day-box { font-size: 7px; color: #333; height: 15px; border-bottom: 0.5px solid #eee; line-height: 15px; }
                    .cell-in { color: blue; }
                    .cell-out { color: darkred; }
                    @media (min-width: 992px) { .container { max-width: 100%; } }
                </style>
                
                <div class="page">
                    <!-- Header IAIN Style -->
                    <div class="header-top">
                        <table style="width: 100%; border:0;">
                            <tr>
                                <td style="width: 15%; text-align: left; border:0;">
                                    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 80px;"/>
                                </td>
                                <td style="width: 70%; text-align: center; border:0;">
                                    <h3>INSTITUT AGAMA ISLAM NEGERI (IAIN) PAREPARE</h3>
                                    <p style="font-size: 10px; margin-bottom:0;">
                                        Jalan Amal Bhakti No. 8 Soreang, Kota Parepare 91132 Telepon (0421) 21307<br/>
                                        Website: www.iainpare.ac.id, Email: mail@iainpare.ac.id
                                    </p>
                                </td>
                                <td style="width: 15%; border:0;"></td>
                            </tr>
                        </table>
                        <h4 style="text-align: center; text-decoration: underline; margin-top: 10px;">REKAP DAFTAR HADIR PEGAWAI</h4>
                        
                        <t t-set="months" t-value="dict(doc._fields['month'].selection)"/>
                        <t t-set="month_label" t-value="'%s %s' % (months.get(doc.month, ''), doc.year)"/>
                        <p style="text-align: left; font-size: 11px;">BULAN : <span t-esc="month_label"/></p>
                    </div>

                    <t t-set="data" t-value="doc.get_report_data()"/>
                    
                    <table class="table-matrix">
                        <thead>
                            <tr style="background-color: #eee;">
                                <th rowspan="2">NO</th>
                                <th rowspan="2" style="width: 150px;">NAMA / NIP</th>
                                <t t-foreach="data['days']" t-as="day">
                                    <th><t t-esc="day"/></th>
                                </t>
                                <th colspan="3" style="font-size: 6px;">TIDAK HADIR</th>
                                <th rowspan="2">HADIR</th>
                                <th rowspan="3" style="font-size: 6px;">KET</th>
                            </tr>
                            <tr style="background-color: #eee;">
                                <t t-foreach="data['days']" t-as="day">
                                    <th style="font-size: 6px;">IN/OUT</th>
                                </t>
                                <th style="font-size: 6px;">TL</th>
                                <th style="font-size: 6px;">PC</th>
                                <th style="font-size: 6px;">TK</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="idx" t-value="1"/>
                            <t t-foreach="data['employees']" t-as="emp">
                                <tr>
                                    <td><t t-esc="idx"/></td>
                                    <td style="text-align: left; font-weight: bold; padding-left: 5px;">
                                        <t t-esc="emp['name']"/><br/>
                                        <small><t t-esc="emp['nip']"/></small>
                                    </td>
                                    
                                    <t t-foreach="data['days']" t-as="day">
                                        <td style="padding: 0; min-width: 20px;">
                                            <t t-if="day in emp['attendances']">
                                                <div class="day-box cell-in"><t t-esc="emp['attendances'][day]['in']"/></div>
                                                <div class="day-box cell-out"><t t-esc="emp['attendances'][day]['out']"/></div>
                                            </t>
                                            <t t-else="">
                                                <div class="day-box">-</div>
                                                <div class="day-box">-</div>
                                            </t>
                                        </td>
                                    </t>
                                    
                                    <td><t t-esc="emp['summary']['tl']"/></td>
                                    <td><t t-esc="emp['summary']['pc']"/></td>
                                    <td><t t-esc="emp['summary']['alpha']"/></td>
                                    <td><t t-esc="len(emp['attendances'])"/></td>
                                    <td> </td>
                                </tr>
                                <t t-set="idx" t-value="idx + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <!-- Signature -->
                    <div style="margin-top: 20px; font-size: 10px;">
                        <table style="width: 100%; border: 0;">
                            <tr>
                                <td style="width: 40%; border: 0; text-align: left; font-size: 8px;">
                                    Keterangan:<br/>
                                    TL = Terlambat | PC = Pulang Cepat | TK = Tanpa Keterangan | C = Cuti
                                </td>
                                <td style="width: 30%; border: 0; text-align: center;">
                                    Mengetahui,<br/>Rektor
                                    <br/><br/><br/><br/>
                                    <strong>( ..................... )</strong>
                                </td>
                                <td style="width: 30%; border: 0; text-align: center;">
                                    Parepare, <t t-esc="doc.month_label()"/><br/>
                                    Kepala Biro AUAK
                                    <br/><br/><br/><br/>
                                    <strong>( ..................... )</strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>

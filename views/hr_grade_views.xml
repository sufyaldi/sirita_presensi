<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tukin_grade_tree" model="ir.ui.view">
        <field name="name">tukin.grade.tree</field>
        <field name="model">tukin.grade</field>
        <field name="arch" type="xml">
            <list string="Kelas Jabatan">
                <field name="grade"/>
                <field name="name"/>
                <field name="pagu_tukin"/>
            </list>
        </field>
    </record>

    <record id="view_tukin_grade_form" model="ir.ui.view">
        <field name="name">tukin.grade.form</field>
        <field name="model">tukin.grade</field>
        <field name="arch" type="xml">
            <form string="Kelas Jabatan">
                <sheet>
                    <group>
                        <field name="grade"/>
                        <field name="name"/>
                        <field name="pagu_tukin"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tukin_grade" model="ir.actions.act_window">
        <field name="name">Kelas Jabatan (Grade)</field>
        <field name="res_model">tukin.grade</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
